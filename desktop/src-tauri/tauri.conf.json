{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT Exporter Desktop",
  "mainBinaryName": "chatgpt-exporter-desktop",
  "version": "2.36.2",
  "identifier": "com.tyhallcsu.chatgpt-exporter-desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node scripts/prepare-userscript.mjs",
    "beforeBuildCommand": "node scripts/prepare-userscript.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ChatGPT Exporter Desktop",
        "width": 940,
        "height": 820,
        "minWidth": 700,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Install the ChatGPT Exporter userscript",
    "longDescription": "A small helper that hands the bundled ChatGPT Exporter userscript to the userscript manager in your browser. The exporter itself stays a userscript; this app only installs and verifies it.",
    "copyright": "ChatGPT Exporter userscript © pionxzh, MIT. Desktop packaging © Tyler Hall Tech LLC, MIT.",
    "publisher": "Tyler Hall Tech LLC",
    "homepage": "https://github.com/tyhallcsu/chatgpt-exporter-fix",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
